{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git Sentinel",
  "version": "0.2.1",
  "identifier": "com.gitsentinel.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Git Sentinel",
        "width": 1180,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "Git Sentinel",
        "url": "splashscreen.html",
        "width": 440,
        "height": 300,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "center": true,
        "decorations": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Local-first dashboard for your Git repositories",
    "longDescription": "Git Sentinel aggregates your local Git repositories into one desktop dashboard: current branch, working-tree state, latest commit, and local/remote-tracking divergence. It observes; it never modifies your repositories.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
